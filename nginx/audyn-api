# Reverse proxy + audio cache for the Audyn API.
#
# This box sits behind cloudflared (Cloudflare Tunnel), not public 80/443 —
# Cloudflare's edge terminates TLS for api.audyn.xyz and cloudflared forwards
# the request here over plain HTTP on localhost. So: no ssl_certificate, no
# certbot, no :80->:443 redirect — just bind loopback and let the tunnel in.
#
# Add a matching ingress rule to your cloudflared config.yml, e.g.:
#   - hostname: api.audyn.xyz
#     service: http://localhost:8080

server {
    listen 127.0.0.1:8080;
    server_name api.audyn.xyz;

    # cloudflared is the only client nginx ever sees directly (over loopback);
    # recover the real visitor IP from the header it sets, so rate limiting
    # and X-Real-IP downstream reflect the actual caller, not 127.0.0.1.
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;

    client_max_body_size 6M;

    gzip on;
    gzip_types application/json application/javascript text/plain text/css;

    limit_req zone=api_limit burst=60 nodelay;

    location / {
        proxy_pass http://audyn_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Local hop is plain HTTP, but the public leg through Cloudflare is
        # always HTTPS — tell the app that directly instead of using $scheme.
        proxy_set_header X-Forwarded-Proto https;

        proxy_buffering off;
        proxy_cache off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Session clip audio, handed off by the app via X-Accel-Redirect.
    # nginx fetches each preview from Spotify once and serves every replay
    # from its disk cache — Python never streams audio bytes.
    # Enable by setting X_ACCEL_AUDIO=true in backend/.env.
    location /_clip/ {
        internal;
        proxy_pass https://p.scdn.co/;
        proxy_ssl_server_name on;
        proxy_set_header Host p.scdn.co;
        proxy_set_header Referer "https://open.spotify.com/";

        proxy_cache audyn_audio;
        proxy_cache_key $uri;
        proxy_cache_valid 200 7d;
        proxy_buffering on;

        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location ~ /\.(env|git|htaccess|htpasswd|gitignore) {
        deny all;
    }

    location ~* /(wp-admin|wp-login\.php|xmlrpc\.php|wp-includes) {
        return 444;
    }

    add_header X-Content-Type-Options "nosniff" always;
}
